function filterEvents(){

    let name = document.getElementById("search").value.toLowerCase();
    let budget = document.getElementById("budget").value;

    let result = document.getElementById("result");

    let events = [
        {name:"Wedding Event", price:"50000"},
        {name:"Birthday Party", price:"10000"},
        {name:"Corporate Event", price:"20000"},
        {name:"Engagement Function", price:"20000"}
    ];

    let output="";

    events.forEach(function(event){

        if((event.name.toLowerCase().includes(name)) &&
          (budget=="" || event.price==budget)){

            output += "<h3>"+event.name+"</h3>";
            output += "<p>Package Price: ₹"+event.price+"</p>";
            output += "<hr>";
        }

    });

    if(output==""){
        result.innerHTML="No event found";
    }
    else{
        result.innerHTML=output;
    }
}
function showText(box){

    let text = box.querySelector("p");

    if(text.style.display=="block"){
        text.style.display="none";
    }
    else{
        text.style.display="block";
    }

}
